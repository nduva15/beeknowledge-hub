          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Free-text search across common name, scientific name, region, notes."
            },
            "limit": {
              "default": 10,
              "description": "Max rows to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
